{
  "name": "jarvis-fitness-ai",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:e2e": "playwright test",
    "android:sync": "npm run build:portable && npm run build && npx cap sync android && node scripts/prepare-personal-backup.mjs",
    "android:open": "npx cap open android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug --no-daemon",
    "postinstall": "node scripts/patch-capacitor.cjs",
    "build:portable": "node scripts/build-portable.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@playwright/test": "^1.52.0",
    "@vitejs/plugin-react": "^4.4.1",
    "acorn": "^8.14.1",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "vite": "^6.3.5"
  },
  "overrides": {
    "tar": "^7.5.7"
  }
}
